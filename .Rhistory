wc %>%
filter(!is.na(weather_source_site)) %>%
count(weather_source_site) %>%
slice_max(n, n = 8) %>% # Wybiera 8 najczęstszych odpowiedzi
ggplot(aes(x = reorder(weather_source_site, n), y = n)) +
geom_col(fill = "cadetblue3") +
