wc %>%
filter(!is.na(weather_source_site)) %>%
# 1. Czyszczenie tekstu
mutate(
site_clean = weather_source_site %>%
str_trim() %>%                   # Usuwa spacje na początku i końcu
str_to_lower(),                  # Zamienia wszystkie litery na małe
# 2. Ujednolicanie podobnych nazw (tzw. standaryzacja)
site_clean = case_when(
str_detect(site_clean, "accu") ~ "AccuWeather",
str_detect(site_clean, "weather.com") ~ "Weather.com",
str_detect(site_clean, "weatherbug|weather bug") ~ "WeatherBug",
str_detect(site_clean, "underground") ~ "Weather Underground",
str_detect(site_clean, "weather channel") ~ "The Weather Channel",
TRUE ~ str_to_title(site_clean)  # Dla pozostałych: pierwsza litera duża
)
) %>%
# 3. Zliczenie ujednoliconych danych
count(site_clean) %>%
slice_max(n, n = 8) %>%
ggplot(aes(x = reorder(site_clean, n), y = n)) +
geom_col(fill = "cadetblue3") +
geom_text(aes(label = n), hjust = -0.2, size = 3.5) +
coord_flip() +
labs(title = "Najpopularniejsze witryny i aplikacje pogodowe",
x = "",
y = "Liczba wskazań") +
theme_minimal()
wc %>%
filter(!is.na(weather_source_site)) %>%
# 1. Podział na pojedyncze słowa (tokeny) i zmiana na małe litery
unnest_tokens(word, weather_source_site) %>%
# 2. Usunięcie ogólnych słów, które nic nie wnoszą (np. "the", "app", "site", "weather")
filter(!word %in% c("the", "app", "site", "weather", "a", "or", "com", "www")) %>%
# 3. Zliczenie najczęstszych słów kluczowych
count(word, sort = TRUE) %>%
slice_max(n, n = 8) %>%
# 4. Wykres
ggplot(aes(x = reorder(word, n), y = n)) +
geom_col(fill = "mediumpurple2") +
geom_text(aes(label = n), hjust = -0.2, size = 3.5) +
coord_flip() +
labs(title = "Najczęściej pojawiające się słowa kluczowe w odpowiedziach",
subtitle = "Po usunięciu ogólnych fraz (np. 'app', 'weather', 'com')",
x = "Słowo kluczowe",
y = "Liczba wystąpień") +
theme_minimal()
